105:            <% end %>
106:          </div>
107:    
108:          <div class="editor-box" id="CriarFormularios" style="display: none;">
109:            <%= form_with url: formularios_path, method: :post, local: true do |f| %>
110:              <label>Template:
111:                <%= f.select :template_id, options_from_collection_for_select(@templates, :id, :nome) %>
112:              </label>
113:              <br>
114:              <label>Nome do Formulário:
115:                <%= f.text_field :nome %>
116:              </label>
117:              <br>
118:              <table>
119:                <tr>
120:                  <th style="width: 10%; padding: 5px;"></th>
121:                  <th style="width: 22,5%; padding: 10px;">Disciplina</th>
122:                  <th style="width: 22,5%; padding: 10px;">Data de Término</th>
123:                  <th style="width: 22,5%; padding: 10px;">Semestre</th>
124:                  <th style="width: 22,5%; padding: 10px;">Class Code</th>
125:                </tr>
126:    
127:                <% @turmas.each do |turma| %>
128:                  <tr>
129:                    <td><%= check_box_tag "formularios[turma_ids][]", turma.id %></td>
130:                    <td><%= turma.codigo %></td>
131:                    <td><%= f.date_field :data_termino %></td>
132:                    <td><%= turma.semestre %></td>
133:                    <td><%= turma.class_code %></td>
134:                  </tr>
135:                <% end %>
136:              </table>
137:    
138:              <%= f.submit "Criar", class: "send-template-button" %>
139:            <% end %>
140:          </div>
141:    
142:          <div class="editor-box" id="VerResultados" style="display: none;">
143:            <form class="template-selector-form">
144:              <label>Classes:
145:                <select class="template-selector" id="classSelector" name="template">
146:                  <% @turmas.each do |turma| %>
147:                    <option value="<%= turma.id %>"><%= turma.codigo + " - " + turma.horario %></option>
148:                  <% end %>
149:                </select>
150:              </label>
151:            </form>
152:    
153:            <table id="resultadosTable">
154:              <tr>
155:                <th style="width: 33%; padding: 10px;">Formulario</th>
156:                <th style="width: 33%; padding: 10px;">Data de Término</th>
157:                <th style="width: 33%; padding: 10px;">Template</th>
158:              </tr>
159:    
160:              <% @formularios.each do |formulario| %>
161:                <tr>
162:                  <td><%= link_to formulario.nome.capitalize, resultados_formulario_path(formulario) %></td>
163:                  <td><%= formulario.dataDeTermino %></td>
164:                  <td><%= formulario.template.nome %></td>
165:                </tr>
166:              <% end %>
167:            </table>
168:          </div>
169:    
170:    
171:          </div>
172:        </div>
173:      </div>
174:      <%= javascript_include_tag 'menu.js' %>
175:      <%= javascript_include_tag 'sign-out.js' %>
176:      <%= javascript_include_tag 'template-management.js' %>
177:      <%= javascript_include_tag 'opcoes-management.js' %>
178:    
179:    </body>
  
