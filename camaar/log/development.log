    <div class="assessments-container">
      <% @turmas.each do |turma| %>
        <% turma.formularios.each do |formulario| %>
          <% if Date.today < formulario.dataDeTermino && !formulario.respondentes.include?(current_user.nome)%>
            <%= link_to formulario_path(formulario) do %>
              <div class="assessments-box">
                <div class="subject-name"><%= formulario.nome %></div>
                <div class="semester"><%="aberto até: " formulario.dataDeTermino %></div>
