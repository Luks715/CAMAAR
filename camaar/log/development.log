              <div class="semester"><%= template.%></div> 
              <div class="professor"><%= template.docente.user.nome %></div> 
            </div>
            <div class="templates-buttonbox">
              <div class="edit-button">
                <%= link_to edit_template_path(template) %>
              </div>
              <div class="trash-button">
                <%= link_to template_path(template), method: :delete, data: { confirm: 'Tem certeza?' } %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>Nenhum template encontrado.</p>
        <% end %>
      </div>
      <div class="add-templates-box">
