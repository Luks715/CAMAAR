<body>
    <div class="questoes-container">
        <div class="titulo"><%= @formulario.nome%></div>
        <%= form_with model: @resultado, local: true, method: :patch do |f| %>
            <% @template.questaos.each do |questao|%>
                <div class="questao">
                    <h3><%= questao.pergunta%></h3>
                     <% if questao.tipo.discursiva == "true" %>
                        <%= f.label "respostas_discursivas[#{questao.id}]", "Resposta para questão #{questao.id}" %>
                        <%= f.text_area "respostas_discursivas[#{questao.id}]", class: "form-control", placeholder: "Digite sua resposta para a questão #{questao.id} aqui" %>

                     <% else %>
                        <% questao.alternativas.each do |alternativa| %>
                            <div class="alternativa">
                                <%= f.radio_button :alternativas_ids, alternativa.id, name: "alternativas_ids[#{questao.id}]", class: "form-check-input" %>
                                <%= f.label :alternativas_ids, alternativa.texto, value: alternativa.id, class: "form-check-label" %>
                            </div>
                        <% end %>
                    <% end %>
                </div>
            <% end %>

            <div class="actions">
                <%= f.submit "Enviar Respostas", class: "btn btn-primary" %>
            </div>
        <% end %>
    </div>
</body>